  "description": "12 hand-authored synthetic SQL error families, one mutant and one algebraically motivated equivalent control per family. Not a representative benchmark of real workloads or LLM outputs.",
  "cases": [
    {
      "id": "join_multiplicity",
      "title": "A join multiplies existence",
      "mechanism": "An inner join repeats a parent for every matching child; EXISTS returns a parent once.",
      "schema": {
        "tables": [
          {
            "name": "p",
            "columns": [
              {
                "name": "id",
                "type": "INTEGER",
                "nullable": false,
                "domain": [
                  1,
                  2,
                  3,
                  4
                ]
              }
            ],
            "primary_key": [
              "id"
            ]
          },
          {
            "name": "c",
            "columns": [
              {
                "name": "pid",
                "type": "INTEGER",
                "nullable": true,
                "domain": [
                  1,
                  2,
                  3,
                  4
                ]
              },
              {
                "name": "amount",
                "type": "INTEGER",
                "nullable": true,
                "domain": [
                  -1,
                  0,
                  1,
                  5,
                  10,
                  20
                ]
              }
            ],
            "foreign_keys": [
              {
                "columns": [
                  "pid"
                ],
                "references": {
                  "table": "p",
                  "columns": [
                    "id"
                  ]
                }
              }
            ]
          }
        ]
      },
      "reference": "SELECT p.id FROM p WHERE EXISTS (SELECT 1 FROM c WHERE c.pid=p.id)",
      "mutant": "SELECT p.id FROM p JOIN c ON c.pid=p.id",
      "equivalent_control": "SELECT DISTINCT p.id FROM p JOIN c ON c.pid=p.id",
      "policy": "bag",
      "benign": {
        "p": [
          [
            1
          ]
        ],
        "c": [
          [
            1,
            5
          ]
        ]
      },
      "revealing": {
        "p": [
          [
            1
          ],
          [
            2
          ]
        ],
        "c": [
          [
            1,
            5
          ],
          [
            1,
            10
          ]
        ]
      },
      "expected_reference": [
        [
          1
        ]
      ],
      "expected_mutant": [
        [
          1
        ],
        [
          1
        ]
      ],
      "origin": "Original synthetic pedagogical fixture; manually specified oracle, no expert-review claim"
    },
