include README.md LICENSE CITATION.cff CONTRIBUTING.md SECURITY.md .gitattributes
recursive-include docs *.md
recursive-include examples *.json *.sql
recursive-include scripts *.py
recursive-exclude * __pycache__ *.py[cod]
prune .openai
recursive-include benchmarks *.json *.jsonl *.md *.py *.sql *.html *.gz SHA256SUMS
recursive-include site *.html *.css *.js *.svg *.md *.py *.cjs
prune site/.git
prune site/.openai
prune site/.sites-runtime

include benchmarks/sqlglot-regression-v1/LICENSE.SQLGLOT
